# Copy to .env (never commit .env)
PORT=3000
DATABASE_URL=postgresql://apniride:apniride_dev@localhost:5432/apniride
REDIS_URL=redis://localhost:6379

# Auth – generate each secret with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-32-chars
# Dev only: return the OTP in the API response (and show it in the app) so no SMS is needed.
OTP_DEV_ECHO=true
SMS_PROVIDER=console

# Admin panel (http://localhost:3001): the one admin signs in with these. Change the password!
# At least 8 characters (12 in production). Changing it signs the admin out.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Drivers & dispatch
OFFER_TIMEOUT_SECONDS=15
BID_TIMEOUT_SECONDS=20
MAX_PARALLEL_REQUESTS=5
SEARCH_TIMEOUT_SECONDS=120
MATCH_RADIUS_KM=5

# Driver onboarding
# Document photos (CNIC, licence…) are stored here. Keep it out of any public web folder.
UPLOAD_DIR=uploads
