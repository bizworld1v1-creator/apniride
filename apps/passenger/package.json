{
  "name": "@apniride/passenger",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@apniride/shared": "workspace:*",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.1",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.6.0",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.10",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --port 8081",
    "start:dev-client": "expo start --dev-client --port 8081",
    "start:tunnel": "expo start --go --tunnel --port 8081",
    "android": "expo start --go --android --port 8081",
    "typecheck": "tsc --noEmit",
    "doctor": "npx -y expo-doctor@latest",
    "build:dev": "npx -y eas-cli@latest build --profile development --platform android",
    "build:preview": "npx -y eas-cli@latest build --profile preview --platform android",
    "update": "npx -y eas-cli@latest update"
  },
