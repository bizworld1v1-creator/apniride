{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // app.config.ts imports the shared theme as a .ts file (Node runs it directly).
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
