{
  "name": "apniride",
  "private": true,
  "description": "ApniRide – trust-first ride-hailing for Pakistan",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "backend": "turbo run dev --filter=@apniride/backend",
    "mobile": "pnpm --filter @apniride/mobile start",
    "db:migrate": "pnpm --filter @apniride/backend migrate",
    "admins": "pnpm --silent --filter @apniride/backend admins",
    "admin": "pnpm --filter @apniride/admin dev",
    "render:vehicles": "node design/vehicles/render.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "turbo": "^2.11.10"
  }
}
